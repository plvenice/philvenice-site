---
layout: base.njk
title: "{{ title }}"
---
<article>
  <div class="post-header">
    <p class="section-label"><a href="/blog/">&larr; All notes</a></p>
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">{{ date | readableDate }}</div>
  </div>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
