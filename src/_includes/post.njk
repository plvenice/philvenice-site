---
layout: base.njk
---
<article class="essay">
  <div class="post-header">
    <p class="section-label"><a href="/blog/">&larr; All writing</a></p>
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">Phil Venice <span aria-hidden="true">/</span> {{ date | readableDate }}</div>
  </div>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
